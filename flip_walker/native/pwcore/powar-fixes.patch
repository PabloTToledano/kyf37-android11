+// ~115200 baud at the emulated clock
+#define IR_STATES_PER_BYTE (STATES_PER_SECOND / 11520)
+#define IR_TX_FLUSH_STATES (IR_STATES_PER_BYTE * 4)
+
+static int ir_port_env(const char *name, int def) {
+    const char *v = getenv(name);
+    return v ? atoi(v) : def;
+}
+
+static void ir_open(pw_context_t *ctx) {
+    ctx->ir_sock = -1;
+#ifndef __EMSCRIPTEN__
+    int s = socket(AF_INET, SOCK_DGRAM, 0);
+    if (s < 0) return;
+    struct sockaddr_in addr = {0};
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    addr.sin_port = htons(ir_port_env("POWAR_IR_PORT", 34561));
+    if (bind(s, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+        printf("[IR] could not bind UDP port, IR disabled\n");
+        close(s);
+        return;
+    }
+    fcntl(s, F_SETFL, O_NONBLOCK);
+    ctx->ir_sock = s;
+    printf("[IR] bridge listening on UDP %d\n", ntohs(addr.sin_port));
+#endif
+}
+
+static void ir_flush_tx(pw_context_t *ctx) {
+#ifndef __EMSCRIPTEN__
+    if (ctx->ir_sock >= 0 && ctx->ir_tx_len > 0) {
+        struct sockaddr_in peer = {0};
+        peer.sin_family = AF_INET;
+        peer.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        peer.sin_port = htons(ir_port_env("POWAR_IR_PEER", 34560));
+        sendto(ctx->ir_sock, ctx->ir_tx, ctx->ir_tx_len, 0, (struct sockaddr *)&peer, sizeof(peer));
+        if (getenv("POWAR_IR_DEBUG")) {
+            printf("%ld [IR TX %d]", ir_clock, ctx->ir_tx_len);
+            for (int i = 0; i < ctx->ir_tx_len; i++) printf(" %.2x", ctx->ir_tx[i] ^ 0xAA);
+            puts("");
+        }
+    }
+#endif
+    ctx->ir_tx_len = 0;
+}
+
+static void ir_update(pw_context_t *ctx, int states) {
+    ir_clock += states;
+    {
+        // stall tracer: POWAR_IR_TRACE dumps PCs if no reply follows a received burst
+        static long last_rx_done = -1, next_dump = 0; static int dumps = 0;
+        static const char *tr = (const char *)1;
+        if (tr == (const char *)1) tr = getenv("POWAR_IR_TRACE");
+        if (tr) {
+            if (ctx->ir_rx_len && ctx->ir_rx_pos == ctx->ir_rx_len && last_rx_done < 0) { last_rx_done = ir_clock; next_dump = ir_clock + 40000; }
+            if (ctx->ir_tx_len) last_rx_done = -1;
+            if (ctx->ir_rx_pos < ctx->ir_rx_len) last_rx_done = -1;
+            if (last_rx_done >= 0 && ir_clock >= next_dump && dumps < 400) {
+                printf("%ld [TRACE] pc=%04x er0=%08x er1=%08x er2=%08x er3=%08x er5=%08x er6=%08x sp=%08x\n", ir_clock, ctx->ip,
+                    read_reg32(ctx,0), read_reg32(ctx,1), read_reg32(ctx,2), read_reg32(ctx,3), read_reg32(ctx,5), read_reg32(ctx,6), read_reg32(ctx,7));
+                next_dump = ir_clock + 997; dumps++;
+            }
+        }
+    }
+    if (ctx->ir_rx_pos < ctx->ir_rx_len && ctx->ir_rx_pos + 1 == ctx->ir_rx_len && !(ctx->ssr & SCI_SSR_RDRF) && getenv("POWAR_IR_DEBUG") && ctx->ir_rx_wait <= states)
+        printf("%ld [IR RX last byte delivered] reads so far %d\n", ir_clock, ir_rdr_reads);
+    // transmit: a burst ends once TDR has been idle for a few byte times
+    if (ctx->ir_tx_len > 0) {
+        ctx->ir_tx_idle += states;
+        if (ctx->ir_tx_idle >= IR_TX_FLUSH_STATES)
+            ir_flush_tx(ctx);
+    }
+
+    // receive: fetch the next burst once the previous one is consumed
+#ifndef __EMSCRIPTEN__
+    if (ctx->ir_rx_pos >= ctx->ir_rx_len && ctx->ir_sock >= 0) {
+        int n = recv(ctx->ir_sock, ctx->ir_rx, sizeof(ctx->ir_rx), 0);
+        if (n > 0) {
+            if (!(ctx->scr & (1 << 4))) { // RE off: walker is not listening
+                if (getenv("POWAR_IR_DEBUG")) printf("%ld [IR RX dropped %d, RE off]\n", ir_clock, n);
+                return;
+            }
+            ctx->ir_rx_len = n;
+            ctx->ir_rx_pos = 0;
+            ir_rdr_reads = 0;
+            // real IR has a turnaround delay; don't land the first byte while the
+            // firmware is still flushing its receiver after transmitting
+            {
+                static long gap = -1;
+                if (gap < 0) { const char *g = getenv("POWAR_IR_GAP"); gap = g ? atol(g) : 8000; }
+                ctx->ir_rx_wait = gap;
+            }
+            if (getenv("POWAR_IR_DEBUG")) {
+                printf("%ld [IR RX %d]", ir_clock, n);
+                for (int i = 0; i < n; i++) printf(" %.2x", ctx->ir_rx[i] ^ 0xAA);
+                puts("");
+            }
+        }
+    }
+#endif
+    if (ctx->ir_rx_pos < ctx->ir_rx_len) {
+        ctx->ir_rx_wait -= states;
+        // hold the byte until the firmware has read the previous one
+        if (ctx->ir_rx_wait <= 0 && !(ctx->ssr & SCI_SSR_RDRF)) {
+            ctx->rdr = ctx->ir_rx[ctx->ir_rx_pos++];
+            ctx->ssr |= SCI_SSR_RDRF;
+            ctx->ir_rx_wait = IR_STATES_PER_BYTE;
+        }
+    }
+}
+
+static void eeprom_save(pw_context_t *ctx) {
+    static uint8_t saved[1 << 16];
+    static int have_saved = 0;
+    if (have_saved && !memcmp(saved, ctx->eeprom_data, sizeof(saved)))
+        return;
+    FILE *f = fopen("eeprom.bin.tmp", "wb");
+    if (!f) return;
+    fwrite(ctx->eeprom_data, 1, 1 << 16, f);
+    fclose(f);
+    rename("eeprom.bin.tmp", "eeprom.bin");
+    memcpy(saved, ctx->eeprom_data, sizeof(saved));
+    have_saved = 1;
+}
+
